# Nunes AI - Sibyl-memory-gated financial agent on Base
#
# Copy to .env and fill in. Everything is optional except when you want
# real onchain settlement (without it the agent runs in simulation mode).
#
#   cp .env.example .env
#
# Never commit a real .env.

# Base Sepolia RPC endpoint used for real settlement
BASE_RPC_URL=https://sepolia.base.org

# Private key of the agent's Base wallet (fund with test ETH + USDC on Sepolia)
# BASE_PRIVATE_KEY=0x...

# USDC contract address (defaults to USDC on Base Sepolia)
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# 1 forces simulated txs even when RPC/key are set (safe for demos)
# NUNES_AI_SIMULATE=0

# 1 (default): live broadcasts only go to vendor addresses registered in
# shared memory by the planner (the vendor directory). 0 restores
# pay-by-raw-address in live mode.
# NUNES_AI_REQUIRE_REGISTERED=1

# Overrides the Sibyl memory database path (default ~/.sibyl-memory/nunes-ai.db)
# NUNES_AI_MEMORY_DB=

# --- LLM "brain" layer (optional) ------------------------------------------
# Turns natural-language instructions into guarded payment intents.
# OpenAI-compatible endpoint; Inception (Mercury) is the default and has a
# free tier. Without a key the brain layer is disabled and the deterministic
# CLI works exactly as before.
# INCEPTION_API_KEY=sk-...
# LLM_BASE_URL=https://api.inceptionlabs.ai/v1
# LLM_MODEL=mercury-2
